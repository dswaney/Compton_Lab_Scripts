{
  "SchemaVersion": "1.0",
  "PolicyVersion": "1.0.0",
  "TrackAllNonSystemApplications": true,
  "IncludePerUserRegistryForLoadedProfiles": false,
  "ExcludeSystemComponents": true,
  "ExcludeUpdatesAndHotfixes": true,
  "IncludeNameRegex": [
    "(?i)Google Chrome",
    "(?i)Mozilla Firefox",
    "(?i)Microsoft Edge$",
    "(?i)Microsoft (?:365|Office)",
    "(?i)Office LTSC",
    "(?i)Adobe (?:Acrobat|Reader|Creative Cloud)",
    "(?i)VLC media player",
    "(?i)Stellarium",
    "(?i)Zoom",
    "(?i)Respondus",
    "(?i)Honorlock",
    "(?i)PaperCut",
    "(?i)Elastic Agent",
    "(?i)Action1",
    "(?i)Deep Freeze"
  ],
  "IncludePublisherRegex": [],
  "ExcludeNameRegex": [
    "(?i)^(?:Security Update|Update|Hotfix|Service Pack|Language Pack) for Microsoft Windows",
    "(?i)^KB\\d+",
    "(?i)^Microsoft Visual C\\+\\+ .*Redistributable",
    "(?i)^Microsoft Edge WebView2 Runtime$",
    "(?i)^Microsoft Update Health Tools$",
    "(?i)^Windows (?:Driver|Software Development Kit|Assessment and Deployment Kit)",
    "(?i)^Microsoft Windows Desktop Runtime",
    "(?i)^Microsoft ASP\\.NET Core .*Shared Framework",
    "(?i)^Microsoft \\.NET (?:Runtime|Host|Host FX Resolver|Targeting Pack|SDK)"
  ],
  "ExcludePublisherRegex": [],
  "ProductRules": [
    { "NameRegex": "(?i)Google Chrome", "CanonicalName": "Google Chrome", "Category": "Browser" },
    { "NameRegex": "(?i)Mozilla Firefox", "CanonicalName": "Mozilla Firefox", "Category": "Browser" },
    { "NameRegex": "(?i)^Microsoft Edge$", "CanonicalName": "Microsoft Edge", "Category": "Browser" },
    { "NameRegex": "(?i)Microsoft Visio", "CanonicalName": "Microsoft Visio", "Category": "Microsoft Office" },
    { "NameRegex": "(?i)Microsoft Project", "CanonicalName": "Microsoft Project", "Category": "Microsoft Office" },
    { "NameRegex": "(?i)Microsoft 365 Apps", "CanonicalName": "Microsoft 365 Apps", "Category": "Microsoft Office" },
    { "NameRegex": "(?i)(?:Microsoft Office|Office LTSC).*2024", "CanonicalName": "Microsoft Office LTSC 2024", "Category": "Microsoft Office" },
    { "NameRegex": "(?i)(?:Microsoft Office|Office LTSC).*2021", "CanonicalName": "Microsoft Office LTSC 2021", "Category": "Microsoft Office" },
    { "NameRegex": "(?i)(?:Microsoft Office|Office LTSC).*2019", "CanonicalName": "Microsoft Office 2019", "Category": "Microsoft Office" },
    { "NameRegex": "(?i)(?:Microsoft Office|Office LTSC).*2016", "CanonicalName": "Microsoft Office 2016", "Category": "Microsoft Office" },
    { "NameRegex": "(?i)(?:Microsoft Office|Office LTSC)", "CanonicalName": "Microsoft Office", "Category": "Microsoft Office" },
    { "NameRegex": "(?i)Adobe (?:Acrobat|Reader)", "CanonicalName": "Adobe Acrobat", "Category": "Adobe" },
    { "NameRegex": "(?i)Adobe Creative Cloud", "CanonicalName": "Adobe Creative Cloud", "Category": "Adobe" },
    { "NameRegex": "(?i)VLC media player", "CanonicalName": "VLC media player", "Category": "Media" },
    { "NameRegex": "(?i)Stellarium", "CanonicalName": "Stellarium", "Category": "Academic" },
    { "NameRegex": "(?i)Respondus", "CanonicalName": "Respondus", "Category": "Academic" },
    { "NameRegex": "(?i)Honorlock", "CanonicalName": "Honorlock", "Category": "Academic" },
    { "NameRegex": "(?i)Zoom", "CanonicalName": "Zoom", "Category": "Communication" },
    { "NameRegex": "(?i)PaperCut", "CanonicalName": "PaperCut", "Category": "Printing" },
    { "NameRegex": "(?i)Elastic Agent", "CanonicalName": "Elastic Agent", "Category": "Management Agent" },
    { "NameRegex": "(?i)Action1", "CanonicalName": "Action1", "Category": "Management Agent" },
    { "NameRegex": "(?i)Deep Freeze", "CanonicalName": "Deep Freeze", "Category": "Endpoint Protection" },
    { "NameRegex": "(?i)(?:CrowdStrike|SentinelOne|Wazuh|Tanium|Qualys)", "CanonicalName": "$0", "Category": "Security" }
  ],
  "DefaultCategory": "Other Third-Party",
  "SnapshotRetentionDays": 730
}
